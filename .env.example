STORE_DB_NAME=store_db
STORE_DB_USER=store
STORE_DB_PASSWORD=store_dev_password
STORE_DB_PORT=5432

AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth_dev_password
AUTH_DB_PORT=5433

AUTH_JWT_SECRET=local-development-only-jwt-secret-change-before-server-deployment
AUTH_TOKEN_EXPIRATION_MS=900000
AUTH_GRPC_PORT=9090
AUTH_GRPC_TIMEOUT_MS=3000

STORE_HTTP_BIND_ADDRESS=0.0.0.0
STORE_HTTP_PORT=8080

# JVM-параметры контейнеров auth и store. Для отладки добавьте:
#   -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
